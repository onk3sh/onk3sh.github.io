---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { recentWriting, parseDay } from '../../data/projects';
---

<BaseLayout title="Writing" description="Essays by Onkesh Bansal on agent memory, AI code review pipelines, and code search tooling, each grounded in production data.">
  <section class="hero">
    <h1>Writing</h1>
    <p>Essays on agent infrastructure: memory layers, review gates, and search tooling. The numbers in them come from my own production work.</p>
  </section>

  <section class="section">
    <div class="grid-2">
      {recentWriting.map((article) => (
        <a class="card" href={`/post/${article.slug}/`}>
          <h3>{article.title}</h3>
          <p>{article.summary}</p>
          <div class="badge-row">
            <span class="badge">{parseDay(article.date).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</span>
            {article.tags && article.tags.map((tag) => (
              <span class={`card-tag tag-${article.projectType}`}>{tag}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
