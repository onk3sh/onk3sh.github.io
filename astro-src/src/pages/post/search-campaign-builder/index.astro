---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { productionWork } from '../../../data/projects';

const section = productionWork[0].sections.find(s => s.heading === 'Search Campaign Builder');
---

<BaseLayout
  title="Search Campaign Builder — Performance Engineering"
  description="Four root causes found and fixed under 4× load growth on a production ad-tech platform: missing indexes, N+1 queries, lock contention, and a concurrency bug. p99 stayed flat throughout."
>

  <article class="post-article">
    <section class="hero">
      <div class="post-meta">
        <span class="badge">Ad-Tech Platform</span>
        <span class="badge">Performance Engineering</span>
        <span class="badge">Java · Spring Boot</span>
      </div>
      <h1>Search Campaign Builder — Performance Engineering</h1>
      <p class="post-lede">I found and fixed a performance failure with four separate root causes, under 4× load growth. The service absorbed that growth at flat p50, p95, and p99 latency.</p>
    </section>

    <div class="post-body panel">
      {section && section.paragraphs && section.paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </article>
</BaseLayout>
