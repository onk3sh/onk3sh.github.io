---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjectBySlug, projects, parseDay } from '../../data/projects';

export function getStaticPaths() {
  // These slugs have hand-written pages at src/pages/post/<slug>/index.astro,
  // which take routing priority. Generating them here too only produces
  // discarded routes and a build warning per slug. Declared inside
  // getStaticPaths because Astro hoists it out of frontmatter scope.
  const staticPostSlugs = new Set([
    'search-campaign-builder',
    'media-activation',
    'agent-memory-three-tiers',
    'rg-vs-ast-grep',
    'iron-law-gates',
    'basis-platform',
  ]);

  return projects
    .filter((project) => !staticPostSlugs.has(project.slug))
    .map((project) => ({
      params: { slug: project.slug }
    }));
}

const { slug } = Astro.params;
const project = getProjectBySlug(slug ?? '');

if (!project) {
  return Astro.redirect('/post/');
}
---

<BaseLayout title={project.title} description={project.summary}>

  <article class="project-hero">
    <section class="hero">
      <h1>{project.title}</h1>
      <p>{project.summary}</p>
      <div class="badge-row">
        <span class="badge">{parseDay(project.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
      </div>
    </section>

    <section class="panel project-content">
      {project.sections.map((section) => (
        <>
          <h2>{section.heading}</h2>
          {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
          {section.bullets && (
            <ul>
              {section.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
          )}
        </>
      ))}

      <p>
        <a href="https://github.com/onk3sh" target="_blank" rel="noopener noreferrer">
          Code and related repositories
        </a>
      </p>
    </section>
  </article>
</BaseLayout>
