---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { recentWork, parseDay } from '../../data/projects';
---

<BaseLayout title="Work" description="Work by Onkesh Bansal: production AI systems, agent engineering, and backend platform projects.">
  <section class="hero">
    <h1>Work</h1>
    <p>Projects in production AI systems and backend platform engineering. Essays live under <a href="/writing/">writing</a>, and merged upstream patches under <a href="/open-source/">open source</a>.</p>
  </section>

  <section class="section">
    <div class="grid-2">
      {recentWork.map((project) => (
        <a class="card" href={`/post/${project.slug}/`}>
          <h3>{project.title}</h3>
          <p>{project.summary}</p>
          <div class="badge-row">
            <span class="badge">{parseDay(project.date).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</span>
            {project.tags && project.tags.map((tag) => (
              <span class={`card-tag tag-${project.projectType}`}>{tag}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
