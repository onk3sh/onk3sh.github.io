---
import BaseLayout from '../layouts/BaseLayout.astro';
import { visualizerSteps } from '../data/lab';
---

<BaseLayout title="Lab" description="Interactive demos and experiments">
  <section class="hero">
    <h1>Lab</h1>
    <p>Interactive demos of the systems I'm building.</p>
  </section>

  <!-- ── Claude Code Harness Visualizer ── -->
  <section class="section">
    <h2>Claude Code Harness — Workflow Visualizer</h2>
    <p class="section-sub">
      An autonomous ticket-to-PR pipeline with persistent memory. Step through each stage or watch it run.
    </p>
    <div class="panel viz-panel">

      <!-- Pipeline nodes -->
      <div class="pipeline" id="pipeline">
        <div class="pipe-node" data-step="0">
          <div class="pipe-icon">🧠</div>
          <div class="pipe-label">Session Memory</div>
          <div class="pipe-sublabel">Scan last 50 sessions</div>
        </div>
        <div class="pipe-arrow">→</div>
        <div class="pipe-node" data-step="1">
          <div class="pipe-icon">🔍</div>
          <div class="pipe-label">Codebase Analysis</div>
          <div class="pipe-sublabel">Map relevant files</div>
        </div>
        <div class="pipe-arrow">→</div>
        <div class="pipe-node" data-step="2">
          <div class="pipe-icon">📋</div>
          <div class="pipe-label">Plan & Draft</div>
          <div class="pipe-sublabel">Spec the implementation</div>
        </div>
        <div class="pipe-arrow">→</div>
        <div class="pipe-node" data-step="3">
          <div class="pipe-icon">⚙️</div>
          <div class="pipe-label">Execute</div>
          <div class="pipe-sublabel">Write, test, commit</div>
        </div>
        <div class="pipe-arrow">→</div>
        <div class="pipe-node" data-step="4">
          <div class="pipe-icon">🔎</div>
          <div class="pipe-label">Review</div>
          <div class="pipe-sublabel">Self-improving loop</div>
        </div>
        <div class="pipe-arrow">→</div>
        <div class="pipe-node" data-step="5">
          <div class="pipe-icon">🚀</div>
          <div class="pipe-label">Open PR</div>
          <div class="pipe-sublabel">Human validates</div>
        </div>
      </div>

      <!-- Detail panel -->
      <div class="viz-detail" id="viz-detail">
        <div class="viz-detail-inner" id="viz-detail-inner">
          <p class="viz-hint">Click a stage or press <strong>Play</strong> to walk through the pipeline.</p>
        </div>
      </div>

      <!-- Controls -->
      <div class="viz-controls">
        <button id="viz-play" type="button">▶ Play</button>
        <button id="viz-prev" type="button">← Prev</button>
        <button id="viz-next" type="button">Next →</button>
        <button id="viz-reset" type="button">Reset</button>
      </div>

    </div>
  </section>

  <!-- ── CanvestAI Sector Dashboard ── -->
  <section class="section">
    <h2>CanvestAI — Sector Recommendations</h2>
    <p class="section-sub">
      Sector bias and confidence from CanvestAI's latest run. Ranked by confidence score.
    </p>
    <div class="panel canvest-panel">
      <div id="canvest-risk-bar" class="risk-bar" style="display:none">
        <span class="risk-bar-label">Systemic Risk</span>
        <span id="canvest-risk-level" class="risk-level-badge"></span>
        <span id="canvest-risk-note" class="risk-bar-note"></span>
      </div>
      <div class="canvest-filter-row">
        <div class="filter-chips" id="bias-chips">
          <button class="chip active" data-bias="all">All</button>
          <button class="chip" data-bias="bullish">Bullish</button>
          <button class="chip" data-bias="neutral">Neutral</button>
          <button class="chip" data-bias="bearish">Bearish</button>
        </div>
        <span class="etf-count" id="sector-count"></span>
      </div>
      <div id="canvest-grid" class="canvest-grid">
        <p class="canvest-loading">Loading…</p>
      </div>
      <p class="etf-disclaimer" id="canvest-disclaimer">Not financial advice. Data sourced from CanvestAI.</p>
    </div>
  </section>

</BaseLayout>

<script type="application/json" id="__lab-steps__" set:html={JSON.stringify(visualizerSteps)}></script>

<script is:inline>
(function () {
  const STEPS = JSON.parse(document.getElementById('__lab-steps__').textContent);

  let current = -1;
  let autoTimer = null;

  const nodes = document.querySelectorAll('.pipe-node');
  const detailInner = document.getElementById('viz-detail-inner');
  const playBtn = document.getElementById('viz-play');
  const prevBtn = document.getElementById('viz-prev');
  const nextBtn = document.getElementById('viz-next');
  const resetBtn = document.getElementById('viz-reset');

  function activate(idx) {
    if (idx < 0 || idx >= STEPS.length) return;
    current = idx;
    const step = STEPS[idx];

    nodes.forEach((n, i) => {
      n.classList.remove('active', 'done');
      if (i < idx) n.classList.add('done');
      if (i === idx) n.classList.add('active');
    });

    detailInner.style.opacity = '0';
    setTimeout(() => {
      detailInner.innerHTML =
        `<div class="step-badge" style="--sc:${step.color}">${step.icon} ${step.title}</div>` +
        `<p class="step-what">${step.what}</p>` +
        `<ul class="step-how">${step.how.map(h => `<li>${h}</li>`).join('')}</ul>` +
        `<div class="step-why"><span>Why it matters</span>${step.why}</div>`;
      detailInner.style.opacity = '1';
    }, 120);
  }

  function reset() {
    stopAuto();
    current = -1;
    nodes.forEach(n => n.classList.remove('active', 'done'));
    detailInner.style.opacity = '0';
    setTimeout(() => {
      detailInner.innerHTML = '<p class="viz-hint">Click a stage or press <strong>Play</strong> to walk through the pipeline.</p>';
      detailInner.style.opacity = '1';
    }, 120);
    playBtn.textContent = '▶ Play';
  }

  function stopAuto() {
    if (autoTimer) { clearInterval(autoTimer); autoTimer = null; }
    playBtn.textContent = '▶ Play';
  }

  function startAuto() {
    stopAuto();
    if (current >= STEPS.length - 1) current = -1;
    activate(current + 1);
    autoTimer = setInterval(() => {
      if (current >= STEPS.length - 1) { stopAuto(); return; }
      activate(current + 1);
    }, 2200);
    playBtn.textContent = '⏸ Pause';
  }

  nodes.forEach((n, i) => {
    n.addEventListener('click', () => { stopAuto(); activate(i); });
  });

  playBtn.addEventListener('click', () => {
    if (autoTimer) { stopAuto(); } else { startAuto(); }
  });

  prevBtn.addEventListener('click', () => { stopAuto(); if (current > 0) activate(current - 1); });
  nextBtn.addEventListener('click', () => { stopAuto(); if (current < STEPS.length - 1) activate(current + 1); });
  resetBtn.addEventListener('click', reset);
})();
</script>

<script is:inline>
(function () {
  var activeBias = 'all';
  var sectors = [];

  var BIAS_COLOR = { bullish: '#34d399', neutral: '#f59e0b', bearish: '#f87171' };
  var BIAS_LIGHT = { bullish: '#0d6f3f', neutral: '#92400e', bearish: '#991b1b' };

  function isLight() {
    return document.documentElement.getAttribute('data-theme') === 'light';
  }

  function fmt1(n) { return n.toFixed(1); }

  function sectorLabel(s) {
    var map = {
      broadmarket:'Broad Market', technology:'Technology', finance:'Finance',
      healthcare:'Healthcare', energy:'Energy', industrials:'Industrials',
      consumer:'Consumer', materials:'Materials', realestate:'Real Estate',
      utilities:'Utilities', semiconductors:'Semiconductors', cleanenergy:'Clean Energy',
      biotech:'Biotech', defense:'Defense', gold:'Gold'
    };
    return map[s] || s.charAt(0).toUpperCase() + s.slice(1);
  }

  function render() {
    var light = isLight();
    var grid = document.getElementById('canvest-grid');
    var count = document.getElementById('sector-count');
    var rows = sectors.filter(function(s) {
      return activeBias === 'all' || s.bias === activeBias;
    });
    count.textContent = rows.length + ' sector' + (rows.length !== 1 ? 's' : '');

    if (rows.length === 0) {
      grid.innerHTML = '<p class="canvest-loading">No sectors match this filter.</p>';
      return;
    }

    grid.innerHTML = rows.map(function(s) {
      var bc = light ? BIAS_LIGHT[s.bias] : BIAS_COLOR[s.bias];
      var barW = Math.round((s.confidence / 100) * 100);
      var tickers = (s.etfs_ca || []).map(function(t) {
        return '<span class="ca-ticker">' + t.replace('.TO','') + '</span>';
      }).join('');
      return '<div class="sector-card">' +
        '<div class="sector-card-top">' +
          '<span class="sector-name">' + sectorLabel(s.sector) + '</span>' +
          '<span class="bias-badge" style="color:' + bc + '">' + s.bias + '</span>' +
        '</div>' +
        '<div class="conf-bar-wrap"><div class="conf-bar" style="width:' + barW + '%"></div></div>' +
        '<div class="conf-label">' + fmt1(s.confidence) + '% confidence · ' + s.horizon_days + 'd horizon</div>' +
        (tickers ? '<div class="ca-tickers">' + tickers + '</div>' : '') +
      '</div>';
    }).join('');
  }

  document.getElementById('bias-chips').addEventListener('click', function(e) {
    var btn = e.target.closest('[data-bias]');
    if (!btn) return;
    activeBias = btn.dataset.bias;
    document.querySelectorAll('[data-bias]').forEach(function(b) { b.classList.toggle('active', b === btn); });
    render();
  });

  new MutationObserver(render).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  fetch('/data/canvest-recommendations.json')
    .then(function(r) { if (!r.ok) throw new Error(); return r.json(); })
    .then(function(data) {
      sectors = (data.sectors || []).slice().sort(function(a,b) { return b.confidence - a.confidence; });

      /* systemic risk bar */
      if (data.systemic_risk) {
        var bar = document.getElementById('canvest-risk-bar');
        var lvl = document.getElementById('canvest-risk-level');
        var note = document.getElementById('canvest-risk-note');
        var riskColor = { LOW: '#34d399', MEDIUM: '#f59e0b', HIGH: '#f87171' };
        bar.style.display = '';
        lvl.textContent = data.systemic_risk.level + ' (' + data.systemic_risk.score + ')';
        lvl.style.color = riskColor[data.systemic_risk.level] || '#f59e0b';
        note.textContent = data.systemic_risk.note;
      }

      /* disclaimer date */
      if (data.generated_at) {
        var d = new Date(data.generated_at);
        var disc = document.getElementById('canvest-disclaimer');
        if (disc) disc.textContent = 'Not financial advice. Data from CanvestAI — as of ' + d.toLocaleDateString('en-CA', { month: 'short', day: 'numeric', year: 'numeric' }) + '.';
      }

      render();
    })
    .catch(function() {
      document.getElementById('canvest-grid').innerHTML = '<p class="canvest-loading">Recommendations unavailable.</p>';
    });
})();
</script>

<style is:inline>
  .section-sub {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin: -0.5rem 0 1rem;
  }

  /* ── Viz panel ── */
  .viz-panel {
    display: grid;
    gap: 1.2rem;
  }

  /* ── Pipeline row ── */
  .pipeline {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .pipe-arrow {
    color: #3a5a7a;
    font-size: 1.2rem;
    flex-shrink: 0;
    margin: 0 0.1rem;
  }

  .pipe-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    border: 1px solid #263d55;
    border-radius: 14px;
    background: #0e1a28;
    padding: 0.75rem 0.85rem;
    cursor: pointer;
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
    min-width: 110px;
    text-align: center;
    user-select: none;
  }

  .pipe-node:hover {
    border-color: #4a7aab;
    transform: translateY(-2px);
  }

  .pipe-node.active {
    border-color: #60a5fa;
    background: linear-gradient(165deg, #162035, #0e1828);
    box-shadow: 0 0 0 3px rgba(96,165,250,0.18), 0 8px 24px rgba(0,0,0,0.35);
    transform: translateY(-3px);
  }

  .pipe-node.done {
    border-color: #1e4a30;
    background: #0b1a14;
  }

  .pipe-node.done .pipe-icon { opacity: 0.6; }

  .pipe-icon {
    font-size: 1.5rem;
    line-height: 1;
    transition: opacity 180ms ease;
  }

  .pipe-label {
    font-size: 0.78rem;
    font-weight: 700;
    color: #c8daf0;
    line-height: 1.2;
  }

  .pipe-sublabel {
    font-size: 0.68rem;
    color: #5a7a9a;
    line-height: 1.2;
  }

  .pipe-node.done .pipe-label { color: #2e7a4a; }

  /* ── Detail panel ── */
  .viz-detail {
    border: 1px solid var(--line);
    border-radius: 14px;
    background: linear-gradient(165deg, #101c2e, #0c1520);
    padding: 1.4rem;
    min-height: 220px;
    display: flex;
    align-items: flex-start;
  }

  .viz-detail-inner {
    width: 100%;
    transition: opacity 120ms ease;
  }

  .viz-hint {
    margin: 0;
    color: #4a6a8a;
    font-size: 0.92rem;
    text-align: center;
    padding: 2rem 0;
  }

  .step-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: color-mix(in srgb, var(--sc) 15%, #0c1828);
    border: 1px solid color-mix(in srgb, var(--sc) 40%, transparent);
    color: var(--sc);
    border-radius: 999px;
    padding: 0.3rem 0.75rem;
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 0.9rem;
    letter-spacing: 0.01em;
  }

  .step-what {
    color: #ccdcf0;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0 0 0.9rem;
  }

  .step-how {
    margin: 0 0 1rem;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.45rem;
  }

  .step-how li {
    color: #8aaac8;
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .step-why {
    border-top: 1px solid #1e3348;
    padding-top: 0.8rem;
    font-size: 0.87rem;
    color: #7a9ab8;
    line-height: 1.55;
  }

  .step-why span {
    display: block;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #4a6a88;
    margin-bottom: 0.3rem;
  }

  /* ── Controls ── */
  .viz-controls {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .viz-controls button {
    border: 1px solid #365172;
    background: #152235;
    color: var(--text);
    padding: 0.45rem 0.85rem;
    border-radius: 10px;
    cursor: pointer;
    font-size: 0.85rem;
    font-family: inherit;
    transition: border-color 130ms ease, background 130ms ease;
  }

  .viz-controls button:hover { border-color: #4b7aab; background: #1c2e45; }

  #viz-play {
    background: #1a3a5c;
    border-color: #3a6898;
    color: #cce2ff;
    font-weight: 600;
  }
  #viz-play:hover { background: #1f4570; border-color: #5a8ec0; }

  @media (max-width: 860px) {
    .pipeline { gap: 0.25rem; }
    .pipe-node { min-width: 90px; padding: 0.6rem 0.6rem; }
    .pipe-arrow { display: none; }
  }

  /* ── Light mode: workflow visualizer ── */
  [data-theme="light"] .pipe-arrow { color: #8aa8c8; }

  [data-theme="light"] .pipe-node {
    background: #ffffff;
    border-color: #c8d8ec;
  }
  [data-theme="light"] .pipe-node:hover { border-color: #7aaad4; }
  [data-theme="light"] .pipe-node.active {
    background: linear-gradient(165deg, #e8f2ff, #f0f6ff);
    border-color: #3b82f6;
    box-shadow: 0 0 0 3px rgba(59,130,246,0.15), 0 8px 24px rgba(0,0,0,0.08);
  }
  [data-theme="light"] .pipe-node.done {
    background: #f0faf4;
    border-color: #86c9a0;
  }
  [data-theme="light"] .pipe-label { color: #1e3a5c; }
  [data-theme="light"] .pipe-sublabel { color: #6b7e96; }
  [data-theme="light"] .pipe-node.done .pipe-label { color: #1a6640; }

  [data-theme="light"] .viz-detail {
    background: linear-gradient(165deg, #f5f9ff, #edf3fb);
  }
  [data-theme="light"] .viz-hint { color: #7a96b4; }
  [data-theme="light"] .step-badge {
    background: color-mix(in srgb, var(--sc) 12%, #f0f6ff);
    border-color: color-mix(in srgb, var(--sc) 35%, transparent);
  }
  [data-theme="light"] .step-what { color: #1e3a5c; }
  [data-theme="light"] .step-how li { color: #3a5a7a; }
  [data-theme="light"] .step-why { border-color: #d0dcea; color: #4a6a8a; }
  [data-theme="light"] .step-why span { color: #8aaac8; }

  [data-theme="light"] .viz-controls button {
    border-color: #b8cce4;
    background: #edf3fb;
    color: #111827;
  }
  [data-theme="light"] .viz-controls button:hover { border-color: #7aaad4; background: #deeaf8; }
  [data-theme="light"] #viz-play {
    background: #c7ddf5;
    border-color: #6a9fd4;
    color: #0f2a50;
  }
  [data-theme="light"] #viz-play:hover { background: #b2d0ee; }

  /* ── CanvestAI Dashboard ── */
  .canvest-panel { display: grid; gap: 1.2rem; }

  .risk-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.75rem 1rem;
    font-size: 0.85rem;
  }

  .risk-bar-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-muted);
    font-weight: 600;
  }

  .risk-level-badge { font-weight: 700; font-size: 0.9rem; }

  .risk-bar-note {
    color: var(--text-muted);
    font-size: 0.82rem;
    flex: 1;
  }

  .canvest-filter-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .filter-chips { display: flex; flex-wrap: wrap; gap: 0.35rem; }

  .chip {
    border: 1px solid var(--line);
    background: transparent;
    color: var(--text-muted);
    border-radius: 999px;
    padding: 0.22rem 0.65rem;
    font-size: 0.8rem;
    cursor: pointer;
    font-family: inherit;
    transition: border-color 120ms ease, background 120ms ease, color 120ms ease;
  }
  .chip:hover { border-color: var(--accent); color: var(--text); }
  .chip.active { border-color: var(--accent); background: var(--accent-soft); color: var(--text); }

  .etf-count {
    margin-left: auto;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .canvest-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  .canvest-loading {
    color: var(--text-muted);
    font-size: 0.9rem;
    text-align: center;
    padding: 2rem 0;
    grid-column: 1/-1;
    margin: 0;
  }

  .sector-card {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: linear-gradient(165deg, rgba(20,28,40,0.9), rgba(14,20,30,0.95));
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .sector-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .sector-name {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text);
  }

  .bias-badge {
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: capitalize;
    flex-shrink: 0;
  }

  .conf-bar-wrap {
    height: 4px;
    background: var(--bg-soft);
    border-radius: 999px;
    overflow: hidden;
  }

  .conf-bar {
    height: 100%;
    background: var(--accent);
    border-radius: 999px;
    transition: width 400ms ease;
  }

  .conf-label {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .ca-tickers {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.1rem;
  }

  .ca-ticker {
    font-size: 0.72rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 0.1rem 0.38rem;
  }

  .etf-disclaimer {
    font-size: 0.76rem;
    color: var(--text-muted);
    margin: 0;
    padding-top: 0.3rem;
    border-top: 1px solid var(--line);
    opacity: 0.7;
  }

  [data-theme="light"] .sector-card {
    background: linear-gradient(165deg, rgba(255,255,255,0.95), rgba(242,246,252,0.98));
  }

  [data-theme="light"] .ca-ticker {
    color: #1e4896;
    background: rgba(37,99,235,0.08);
    border-color: #a8c0e0;
  }

  @media (max-width: 860px) {
    .canvest-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 560px) {
    .canvest-grid { grid-template-columns: 1fr; }
  }
</style>
