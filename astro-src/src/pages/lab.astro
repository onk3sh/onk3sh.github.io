---
import BaseLayout from '../layouts/BaseLayout.astro';
import { visualizerSteps } from '../data/lab';
---

<BaseLayout title="Lab" description="Interactive demos and experiments">
  <section class="hero">
    <h1>Lab</h1>
    <p>Interactive demos of the systems I'm building.</p>
  </section>

  <!-- ── Claude Code Harness Visualizer ── -->
  <section class="section">
    <h2>Claude Code Harness — Workflow Visualizer <a href="/post/claude-code-harness/" class="panel-link">↗ read the write-up</a></h2>
    <p class="section-sub">
      An autonomous ticket-to-PR pipeline with persistent memory. Step through each stage or watch it run.
    </p>
    <div class="panel viz-panel">

      <!-- Pipeline nodes -->
      <div class="pipeline" id="pipeline">
        <div class="pipe-node" data-step="0">
          <div class="pipe-icon">🧠</div>
          <div class="pipe-label">Session Memory</div>
          <div class="pipe-sublabel">Scan last 50 sessions</div>
        </div>
        <div class="pipe-arrow">→</div>
        <div class="pipe-node" data-step="1">
          <div class="pipe-icon">🔍</div>
          <div class="pipe-label">Codebase Analysis</div>
          <div class="pipe-sublabel">Map relevant files</div>
        </div>
        <div class="pipe-arrow">→</div>
        <div class="pipe-node" data-step="2">
          <div class="pipe-icon">📋</div>
          <div class="pipe-label">Plan & Draft</div>
          <div class="pipe-sublabel">Spec the implementation</div>
        </div>
        <div class="pipe-arrow">→</div>
        <div class="pipe-node" data-step="3">
          <div class="pipe-icon">⚙️</div>
          <div class="pipe-label">Execute</div>
          <div class="pipe-sublabel">Write, test, commit</div>
        </div>
        <div class="pipe-arrow">→</div>
        <div class="pipe-node" data-step="4">
          <div class="pipe-icon">🔎</div>
          <div class="pipe-label">Review</div>
          <div class="pipe-sublabel">Self-improving loop</div>
        </div>
        <div class="pipe-arrow">→</div>
        <div class="pipe-node" data-step="5">
          <div class="pipe-icon">🚀</div>
          <div class="pipe-label">Open PR</div>
          <div class="pipe-sublabel">Human validates</div>
        </div>
      </div>

      <!-- Detail panel -->
      <div class="viz-detail" id="viz-detail">
        <div class="viz-detail-inner" id="viz-detail-inner">
          <p class="viz-hint">Click a stage or press <strong>Play</strong> to walk through the pipeline.</p>
        </div>
      </div>

      <!-- Controls -->
      <div class="viz-controls">
        <button id="viz-play" type="button">▶ Play</button>
        <button id="viz-prev" type="button">← Prev</button>
        <button id="viz-next" type="button">Next →</button>
        <button id="viz-reset" type="button">Reset</button>
      </div>

    </div>
  </section>

  <!-- ── CanvestAI Sector Dashboard ── -->
  <section class="section">
    <h2>CanvestAI — Sector Signals <a href="/post/canvestai/" class="panel-link">↗ read the write-up</a></h2>
    <p class="section-sub">
      Equity sector bias signals from CanvestAI · 30-day horizon · 15 sectors · Canadian ETF universe. Ranked by model confidence.
    </p>
    <div class="panel canvest-panel">
      <div id="canvest-risk-bar" class="risk-bar" style="display:none">
        <span class="risk-bar-label">Systemic Risk</span>
        <span id="canvest-risk-level" class="risk-level-badge"></span>
        <span id="canvest-risk-note" class="risk-bar-note"></span>
      </div>

      <!-- Portfolio Allocation -->
      <div id="canvest-alloc-panel" style="display:none">
        <div class="alloc-header">
          <span class="alloc-title">Model Allocation</span>
          <span class="alloc-meta" id="alloc-meta"></span>
        </div>
        <div id="alloc-rows" class="alloc-rows"></div>
        <div class="alloc-note" id="alloc-note"></div>
      </div>

      <!-- Tabs -->
      <div class="canvest-tabs">
        <button class="canvest-tab active" data-tab="sectors">Sectors</button>
        <button class="canvest-tab" data-tab="etfs">ETFs</button>
        <button class="canvest-tab" data-tab="trades">Paper Trades</button>
      </div>

      <!-- Sectors tab -->
      <div id="tab-sectors">
        <div class="canvest-filter-row">
          <div class="filter-chips" id="bias-chips">
            <button class="chip active" data-bias="all">All</button>
            <button class="chip" data-bias="bullish">Bullish</button>
            <button class="chip" data-bias="neutral">Neutral</button>
            <button class="chip" data-bias="bearish">Bearish</button>
          </div>
          <span class="etf-count" id="sector-count"></span>
        </div>
        <div id="canvest-grid" class="canvest-grid">
          <p class="canvest-loading">Loading…</p>
        </div>
      </div>

      <!-- ETFs tab -->
      <div id="tab-etfs" style="display:none">
        <div class="canvest-filter-row">
          <div class="filter-chips" id="etf-bias-chips">
            <button class="chip active" data-etf-bias="all">All</button>
            <button class="chip" data-etf-bias="bullish">Bullish</button>
            <button class="chip" data-etf-bias="neutral">Neutral</button>
            <button class="chip" data-etf-bias="bearish">Bearish</button>
          </div>
          <span class="etf-count" id="etf-list-count"></span>
        </div>
        <div class="mer-filter-row">
          <label class="mer-label" for="mer-slider">Max MER: <span id="mer-value">1.00</span>%</label>
          <input type="range" id="mer-slider" min="0" max="1" step="0.01" value="1" class="mer-slider">
        </div>
        <div class="etf-table-wrap">
          <table class="etf-table" id="canvest-etf-table">
            <thead>
              <tr>
                <th>Ticker</th>
                <th>Name</th>
                <th>Sector</th>
                <th>Bias</th>
                <th title="Model confidence across signal sources">Confidence</th>
                <th title="Management Expense Ratio">MER %</th>
              </tr>
            </thead>
            <tbody id="canvest-etf-tbody"></tbody>
          </table>
        </div>
      </div>

      <!-- Trades tab -->
      <div id="tab-trades" style="display:none">
        <div class="trades-summary" id="trades-summary"></div>
        <div class="canvest-filter-row" style="margin-top:0.75rem">
          <div class="filter-chips" id="trades-status-chips">
            <button class="chip active" data-trade-status="open">Open</button>
            <button class="chip" data-trade-status="closed">Closed</button>
          </div>
          <span class="etf-count" id="trades-count"></span>
        </div>
        <div class="etf-table-wrap">
          <table class="etf-table" id="canvest-trades-table">
            <thead>
              <tr>
                <th>ETF</th>
                <th>Name</th>
                <th>Sector</th>
                <th>Entry</th>
                <th>P&amp;L %</th>
                <th title="P&L minus SPY return over same period">vs SPY</th>
                <th title="Model confidence at signal time">Conf</th>
              </tr>
            </thead>
            <tbody id="canvest-trades-tbody"></tbody>
          </table>
        </div>
      </div>

      <p class="etf-disclaimer" id="canvest-disclaimer">Not financial advice. Data sourced from CanvestAI.</p>
    </div>
  </section>

</BaseLayout>

<script type="application/json" id="__lab-steps__" set:html={JSON.stringify(visualizerSteps)}></script>

<script is:inline>
(function () {
  const STEPS = JSON.parse(document.getElementById('__lab-steps__').textContent);

  let current = -1;
  let autoTimer = null;

  const nodes = document.querySelectorAll('.pipe-node');
  const detailInner = document.getElementById('viz-detail-inner');
  const playBtn = document.getElementById('viz-play');
  const prevBtn = document.getElementById('viz-prev');
  const nextBtn = document.getElementById('viz-next');
  const resetBtn = document.getElementById('viz-reset');

  function activate(idx) {
    if (idx < 0 || idx >= STEPS.length) return;
    current = idx;
    const step = STEPS[idx];

    nodes.forEach((n, i) => {
      n.classList.remove('active', 'done');
      if (i < idx) n.classList.add('done');
      if (i === idx) n.classList.add('active');
    });

    detailInner.style.opacity = '0';
    setTimeout(() => {
      detailInner.innerHTML =
        `<div class="step-badge" style="--sc:${step.color}">${step.icon} ${step.title}</div>` +
        `<p class="step-what">${step.what}</p>` +
        `<ul class="step-how">${step.how.map(h => `<li>${h}</li>`).join('')}</ul>` +
        `<div class="step-why"><span>Why it matters</span>${step.why}</div>`;
      detailInner.style.opacity = '1';
    }, 120);
  }

  function reset() {
    stopAuto();
    current = -1;
    nodes.forEach(n => n.classList.remove('active', 'done'));
    detailInner.style.opacity = '0';
    setTimeout(() => {
      detailInner.innerHTML = '<p class="viz-hint">Click a stage or press <strong>Play</strong> to walk through the pipeline.</p>';
      detailInner.style.opacity = '1';
    }, 120);
    playBtn.textContent = '▶ Play';
  }

  function stopAuto() {
    if (autoTimer) { clearInterval(autoTimer); autoTimer = null; }
    playBtn.textContent = '▶ Play';
  }

  function startAuto() {
    stopAuto();
    if (current >= STEPS.length - 1) current = -1;
    activate(current + 1);
    autoTimer = setInterval(() => {
      if (current >= STEPS.length - 1) { stopAuto(); return; }
      activate(current + 1);
    }, 2200);
    playBtn.textContent = '⏸ Pause';
  }

  nodes.forEach((n, i) => {
    n.addEventListener('click', () => { stopAuto(); activate(i); });
  });

  playBtn.addEventListener('click', () => {
    if (autoTimer) { stopAuto(); } else { startAuto(); }
  });

  prevBtn.addEventListener('click', () => { stopAuto(); if (current > 0) activate(current - 1); });
  nextBtn.addEventListener('click', () => { stopAuto(); if (current < STEPS.length - 1) activate(current + 1); });
  resetBtn.addEventListener('click', reset);
})();
</script>

<script is:inline>
(function () {
  var activeBias = 'all';
  var sectors = [];
  var etfMeta = {}; /* ticker -> { name, mer } */

  var BIAS_COLOR = { bullish: '#34d399', neutral: '#f59e0b', bearish: '#f87171' };
  var BIAS_LIGHT = { bullish: '#0d6f3f', neutral: '#92400e', bearish: '#991b1b' };

  function isLight() {
    return document.documentElement.getAttribute('data-theme') === 'light';
  }

  function fmt1(n) { return n.toFixed(1); }

  function sectorLabel(s) {
    var map = {
      broadmarket:'Broad Market', technology:'Technology', finance:'Finance',
      healthcare:'Healthcare', energy:'Energy', industrials:'Industrials',
      consumer:'Consumer', materials:'Materials', realestate:'Real Estate',
      utilities:'Utilities', semiconductors:'Semiconductors', cleanenergy:'Clean Energy',
      biotech:'Biotech', defense:'Defense', gold:'Gold'
    };
    return map[s] || s.charAt(0).toUpperCase() + s.slice(1);
  }

  function render() {
    var light = isLight();
    var grid = document.getElementById('canvest-grid');
    var count = document.getElementById('sector-count');
    var rows = sectors.filter(function(s) {
      return activeBias === 'all' || s.bias === activeBias;
    });
    count.textContent = rows.length + ' sector' + (rows.length !== 1 ? 's' : '');

    if (rows.length === 0) {
      grid.innerHTML = '<p class="canvest-loading">No sectors match this filter.</p>';
      return;
    }

    grid.innerHTML = rows.map(function(s) {
      var bc = light ? BIAS_LIGHT[s.bias] : BIAS_COLOR[s.bias];
      var barW = Math.round((s.confidence / 100) * 100);
      var tickers = (s.etfs_ca || []).map(function(t) {
        var tk = typeof t === 'string' ? t : t.ticker;
        return '<span class="ca-ticker">' + tk.replace('.TO','') + '</span>';
      }).join('');
      return '<div class="sector-card">' +
        '<div class="sector-card-top">' +
          '<span class="sector-name">' + sectorLabel(s.sector) + '</span>' +
          '<span class="bias-badge" style="color:' + bc + '">' + s.bias + '</span>' +
        '</div>' +
        '<div class="conf-bar-wrap"><div class="conf-bar" style="width:' + barW + '%"></div></div>' +
        '<div class="conf-label" title="Confidence reflects model agreement across signal sources">' + fmt1(s.confidence) + '% confidence</div>' +
        (tickers ? '<div class="ca-tickers">' + tickers + '</div>' : '') +
      '</div>';
    }).join('');
  }

  /* ── tabs ── */
  document.querySelectorAll('.canvest-tab').forEach(function(tab) {
    tab.addEventListener('click', function() {
      document.querySelectorAll('.canvest-tab').forEach(function(t) { t.classList.remove('active'); });
      tab.classList.add('active');
      var target = tab.dataset.tab;
      document.getElementById('tab-sectors').style.display = target === 'sectors' ? '' : 'none';
      document.getElementById('tab-etfs').style.display = target === 'etfs' ? '' : 'none';
      document.getElementById('tab-trades').style.display = target === 'trades' ? '' : 'none';
    });
  });

  document.getElementById('bias-chips').addEventListener('click', function(e) {
    var btn = e.target.closest('[data-bias]');
    if (!btn) return;
    activeBias = btn.dataset.bias;
    document.querySelectorAll('[data-bias]').forEach(function(b) { b.classList.toggle('active', b === btn); });
    render();
  });

  var US_ETF_NAMES = {
    SPY: 'SPDR S&P 500 ETF Trust',
    XLK: 'Technology Select Sector SPDR',
    XLE: 'Energy Select Sector SPDR',
    XLY: 'Consumer Discretionary Select Sector SPDR',
    XLF: 'Financial Select Sector SPDR',
    XLI: 'Industrial Select Sector SPDR',
    XLU: 'Utilities Select Sector SPDR',
    XBI: 'SPDR S&P Biotech ETF',
    GDX: 'VanEck Gold Miners ETF'
  };

  /* ── ETF tab filter ── */
  var activeEtfBias = 'all';
  var maxMer = 1.0;

  var merSlider = document.getElementById('mer-slider');
  var merValue = document.getElementById('mer-value');
  merSlider.addEventListener('input', function() {
    maxMer = parseFloat(merSlider.value);
    merValue.textContent = maxMer.toFixed(2);
    renderEtfs();
  });

  document.getElementById('etf-bias-chips').addEventListener('click', function(e) {
    var btn = e.target.closest('[data-etf-bias]');
    if (!btn) return;
    activeEtfBias = btn.dataset.etfBias;
    document.querySelectorAll('[data-etf-bias]').forEach(function(b) { b.classList.toggle('active', b === btn); });
    renderEtfs();
  });

  function renderEtfs() {
    var light = isLight();
    var BIAS_COLOR_ETF = { bullish: '#34d399', neutral: '#f59e0b', bearish: '#f87171' };
    var BIAS_LIGHT_ETF = { bullish: '#0d6f3f', neutral: '#92400e', bearish: '#991b1b' };
    var rows = [];
    sectors.forEach(function(s) {
      if (activeEtfBias !== 'all' && s.bias !== activeEtfBias) return;
      (s.etfs_ca || []).forEach(function(t) {
        var clean = (typeof t === 'string' ? t : t.ticker).replace('.TO', '');
        var meta = etfMeta[clean] || {};
        var mer = meta.mer != null ? meta.mer : null;
        if (mer !== null && mer > maxMer) return;
        rows.push({ ticker: clean, name: meta.name || '—', sector: s.sector, bias: s.bias, confidence: s.confidence, mer: mer });
      });
    });
    rows.sort(function(a, b) { return b.confidence - a.confidence; });

    var count = document.getElementById('etf-list-count');
    count.textContent = rows.length + ' ETF' + (rows.length !== 1 ? 's' : '');

    var tbody = document.getElementById('canvest-etf-tbody');
    tbody.innerHTML = rows.map(function(r) {
      var bc = light ? BIAS_LIGHT_ETF[r.bias] : BIAS_COLOR_ETF[r.bias];
      var barW = Math.round((r.confidence / 100) * 80);
      return '<tr>' +
        '<td class="etf-ticker">' + r.ticker + '</td>' +
        '<td style="font-size:0.82rem;color:var(--text-muted)">' + r.name + '</td>' +
        '<td style="color:var(--text-muted);font-size:0.85rem">' + sectorLabel(r.sector) + '</td>' +
        '<td><span style="color:' + bc + ';font-weight:700;font-size:0.82rem;text-transform:capitalize">' + r.bias + '</span></td>' +
        '<td><div style="display:flex;align-items:center;gap:0.5rem">' +
          '<div style="width:80px;height:4px;background:var(--bg-soft);border-radius:999px;overflow:hidden">' +
            '<div style="width:' + barW + 'px;height:100%;background:var(--accent);border-radius:999px"></div>' +
          '</div>' +
          '<span style="font-size:0.82rem;color:var(--text-muted)">' + fmt1(r.confidence) + '%</span>' +
        '</div></td>' +
        '<td style="font-size:0.82rem;color:var(--text-muted);text-align:right">' + (r.mer !== null ? r.mer.toFixed(2) + '%' : '—') + '</td>' +
      '</tr>';
    }).join('');
  }

  /* ── Trades tab ── */
  var paperTrades = { open_positions: [], closed_positions: [], summary: {} };
  var activeTradeStatus = 'open';

  document.getElementById('trades-status-chips').addEventListener('click', function(e) {
    var btn = e.target.closest('[data-trade-status]');
    if (!btn) return;
    activeTradeStatus = btn.dataset.tradeStatus;
    document.querySelectorAll('[data-trade-status]').forEach(function(b) { b.classList.toggle('active', b === btn); });
    renderTrades();
  });

  function renderTrades() {
    var light = isLight();
    var PNL_POS = light ? '#0d6f3f' : '#34d399';
    var PNL_NEG = light ? '#991b1b' : '#f87171';
    var rows = activeTradeStatus === 'open' ? paperTrades.open_positions : paperTrades.closed_positions;
    var count = document.getElementById('trades-count');
    count.textContent = rows.length + ' trade' + (rows.length !== 1 ? 's' : '');
    var tbody = document.getElementById('canvest-trades-tbody');
    tbody.innerHTML = rows.map(function(t) {
      var pnlColor = t.pnl_pct >= 0 ? PNL_POS : PNL_NEG;
      var pnlStr = (t.pnl_pct >= 0 ? '+' : '') + fmt1(t.pnl_pct) + '%';
      var excess = t.excess_return != null ? ((t.excess_return >= 0 ? '+' : '') + fmt1(t.excess_return) + '%') : '—';
      var excessColor = t.excess_return != null ? (t.excess_return >= 0 ? PNL_POS : PNL_NEG) : 'var(--text-muted)';
      var entryDate = t.entry_date ? new Date(t.entry_date).toLocaleDateString('en-CA', { month: 'short', day: 'numeric' }) : '—';
      return '<tr>' +
        '<td class="etf-ticker">' + t.etf + '</td>' +
        '<td style="font-size:0.82rem;color:var(--text-muted)">' + (US_ETF_NAMES[t.etf] || '—') + '</td>' +
        '<td style="font-size:0.82rem;color:var(--text-muted)">' + sectorLabel(t.sector) + '</td>' +
        '<td style="font-size:0.82rem;color:var(--text-muted)">' + entryDate + '</td>' +
        '<td style="font-weight:700;font-size:0.82rem;color:' + pnlColor + '">' + pnlStr + '</td>' +
        '<td style="font-size:0.82rem;color:' + excessColor + '">' + excess + '</td>' +
        '<td style="font-size:0.82rem;color:var(--text-muted);text-align:right">' + fmt1(t.confidence) + '%</td>' +
      '</tr>';
    }).join('');
  }

  new MutationObserver(function() { render(); renderEtfs(); renderTrades(); }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  Promise.all([
    fetch('/data/canvest-recommendations.json').then(function(r) { if (!r.ok) throw new Error(); return r.json(); }),
    fetch('/data/canvest-etfs.json').then(function(r) { return r.ok ? r.json() : { etfs: [] }; })
  ])
    .then(function(results) {
      var data = results[0];
      var etfsData = results[1];
      (etfsData.etfs || []).forEach(function(e) { etfMeta[e.ticker] = { name: e.name, mer: e.mer }; });
      sectors = (data.sectors || []).slice().sort(function(a,b) { return b.confidence - a.confidence; });

      /* systemic risk bar */
      if (data.systemic_risk) {
        var bar = document.getElementById('canvest-risk-bar');
        var lvl = document.getElementById('canvest-risk-level');
        var note = document.getElementById('canvest-risk-note');
        var riskColor = { LOW: '#34d399', MEDIUM: '#f59e0b', HIGH: '#f87171' };
        var bullish = sectors.filter(function(s) { return s.bias === 'bullish'; }).length;
        var neutral = sectors.filter(function(s) { return s.bias === 'neutral'; }).length;
        var bearish = sectors.filter(function(s) { return s.bias === 'bearish'; }).length;
        var generatedNote = bullish + ' of ' + sectors.length + ' sectors bullish';
        if (neutral > 0) generatedNote += ', ' + neutral + ' neutral';
        if (bearish > 0) generatedNote += ', ' + bearish + ' bearish';
        generatedNote += '. ' + (data.horizon_days || 30) + '-day horizon.';
        bar.style.display = '';
        lvl.textContent = data.systemic_risk.level + ' (' + data.systemic_risk.score + ')';
        lvl.style.color = riskColor[data.systemic_risk.level] || '#f59e0b';
        note.textContent = generatedNote;
      }

      /* portfolio allocation */
      var alloc = data.portfolio_allocation;
      if (alloc && (alloc.allocations || []).length > 0) {
        var BIAS_ALLOC = { bullish: '#34d399', neutral: '#f59e0b', bearish: '#f87171' };
        var panel = document.getElementById('canvest-alloc-panel');
        var meta = document.getElementById('alloc-meta');
        var rowsEl = document.getElementById('alloc-rows');
        var noteEl = document.getElementById('alloc-note');
        var totalInvest = alloc.investment || 0;
        meta.textContent = 'CAD universe · simulated ' + (alloc.currency || 'USD') + ' ' + totalInvest.toLocaleString() + ' · as of ' + alloc.as_of;
        rowsEl.innerHTML = alloc.allocations.map(function(a) {
          var pct = a.allocation_pct || 0;
          var bc = BIAS_ALLOC[a.bias] || '#f59e0b';
          var until = a.hold_until ? new Date(a.hold_until).toLocaleDateString('en-CA', { month: 'short', day: 'numeric' }) : '—';
          return '<div class="alloc-row">' +
            '<div class="alloc-row-left">' +
              '<span class="alloc-sector">' + sectorLabel(a.sector) + '</span>' +
              '<span class="alloc-tickers">' + a.etf_ca.replace('.TO','') + (a.etf_us ? ' · ' + a.etf_us : '') + '</span>' +
            '</div>' +
            '<div class="alloc-row-right">' +
              '<div class="alloc-bar-wrap"><div class="alloc-bar" style="width:' + Math.round(pct) + '%;background:' + bc + '"></div></div>' +
              '<span class="alloc-pct">' + pct.toFixed(0) + '%</span>' +
              '<span class="alloc-until">hold to ' + until + '</span>' +
            '</div>' +
          '</div>';
        }).join('');
        if (alloc.cash_pct > 0) {
          noteEl.textContent = alloc.cash_pct.toFixed(0) + '% cash · ' + (alloc.note || '');
        } else {
          noteEl.textContent = alloc.note || '';
        }
        panel.style.display = '';
      }

      /* disclaimer date */
      if (data.generated_at) {
        var d = new Date(data.generated_at);
        var disc = document.getElementById('canvest-disclaimer');
        if (disc) disc.textContent = 'Not financial advice. Generated by CanvestAI · updated ' + d.toLocaleDateString('en-CA', { month: 'short', day: 'numeric', year: 'numeric' }) + ' · runs on demand.';
      }

      /* paper trades */
      if (data.paper_trading) {
        var pt = data.paper_trading;
        paperTrades.open_positions = pt.open_positions || [];
        paperTrades.closed_positions = pt.closed_positions || [];
        paperTrades.summary = pt.summary || {};
        var s = paperTrades.summary;
        var summaryEl = document.getElementById('trades-summary');
        var totalPnl = s.total_pnl_usd || 0;
        var pnlColor = totalPnl >= 0 ? '#34d399' : '#f87171';
        summaryEl.innerHTML =
          '<div class="trades-stat"><span class="trades-stat-val">' + (s.win_rate_pct || 0).toFixed(1) + '%</span><span class="trades-stat-label">win rate</span></div>' +
          '<div class="trades-stat"><span class="trades-stat-val" style="color:' + pnlColor + '">' + (totalPnl >= 0 ? '+' : '') + '$' + totalPnl.toFixed(0) + '</span><span class="trades-stat-label">total P&L</span></div>' +
          '<div class="trades-stat"><span class="trades-stat-val">' + (s.open_trades || 0) + '</span><span class="trades-stat-label">open</span></div>' +
          '<div class="trades-stat"><span class="trades-stat-val">' + (s.closed_trades || 0) + '</span><span class="trades-stat-label">closed</span></div>' +
          '<div class="trades-stat"><span class="trades-stat-val" style="color:' + ((s.avg_excess_vs_spy || 0) >= 0 ? '#34d399' : '#f87171') + '">' + ((s.avg_excess_vs_spy || 0) >= 0 ? '+' : '') + fmt1(s.avg_excess_vs_spy || 0) + '%</span><span class="trades-stat-label">avg vs SPY</span></div>';
      }

      render();
      renderEtfs();
      renderTrades();
    })
    .catch(function() {
      document.getElementById('canvest-grid').innerHTML = '<p class="canvest-loading">Recommendations unavailable.</p>';
    });
})();
</script>

