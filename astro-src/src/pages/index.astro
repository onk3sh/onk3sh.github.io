---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import NowStrip from '../components/NowStrip.astro';
import SectionBar from '../components/SectionBar.astro';
import { featuredWorkProjects, featuredPersonalProjects, featuredArticles } from '../data/projects';
import { hero } from '../data/hero';
---

<BaseLayout title="Home" description={hero.metaDescription} fullWidth={true}>
  <Header slot="header" path="/" />

  <Hero />
  <NowStrip />

  <SectionBar id="work" label="§ 01" title="Work" />
  <div class="home-container home-section">
    <div class="grid-3">
      {[...featuredWorkProjects, ...featuredPersonalProjects].map((project) => (
        <a class="card card-project reveal-up" href={`/post/${project.slug}/`}>
          {project.tags && (
            <div class="card-tags">
              {project.tags.map((tag) => (
                <span class={`card-tag tag-${project.projectType}`}>{tag}</span>
              ))}
            </div>
          )}
          <h3>{project.title}</h3>
          <p>{project.summary}</p>
        </a>
      ))}
    </div>
  </div>

  <SectionBar id="writing" label="§ 02" title="Writing" />
  <div class="home-container home-section">
    <div class="grid-3">
      {featuredArticles.map((article) => (
        <a class="card reveal-up" href={`/post/${article.slug}/`}>
          {article.tags && (
            <div class="card-tags">
              {article.tags.map((tag) => (
                <span class={`card-tag tag-${article.projectType}`}>{tag}</span>
              ))}
            </div>
          )}
          <h3>{article.title}</h3>
          <p>{article.summary}</p>
        </a>
      ))}
    </div>
  </div>

  <SectionBar id="stack" label="§ 03" title="Stack" />
  <div class="home-container home-section">
    <div class="stack-grid">
      <div class="stack-row">
        <span class="stack-label">Languages</span>
        <span class="stack-items">Java · Python · TypeScript</span>
      </div>
      <div class="stack-row">
        <span class="stack-label">Backend</span>
        <span class="stack-items">Spring Boot · Quarkus · PostgreSQL · Redis · Datadog</span>
      </div>
      <div class="stack-row">
        <span class="stack-label">AI</span>
        <span class="stack-items">Claude API · Claude Code · MCP · ast-grep · LSP · Autonomous agents</span>
      </div>
      <div class="stack-row">
        <span class="stack-label">Infra</span>
        <span class="stack-items">Kubernetes · Docker · AWS</span>
      </div>
    </div>
  </div>

  <div id="contact" class="home-container home-section contact-strip">
    <a href="mailto:onkesh2022@gmail.com" class="contact-link">onkesh2022@gmail.com</a>
    <a href="https://linkedin.com/in/onkesh" target="_blank" rel="noopener" class="contact-link">linkedin</a>
    <a href="https://github.com/onk3sh" target="_blank" rel="noopener" class="contact-link">github</a>
  </div>
</BaseLayout>

<script is:inline>
(function () {
  var revealNodes = Array.from(document.querySelectorAll('.reveal-up'));
  if ('IntersectionObserver' in window) {
    var obs = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) { e.target.classList.add('is-visible'); obs.unobserve(e.target); }
      });
    }, { threshold: 0.12 });
    revealNodes.forEach(function(n) { obs.observe(n); });
  } else {
    revealNodes.forEach(function(n) { n.classList.add('is-visible'); });
  }
})();
</script>

<style is:inline>
  .home-container { max-width: 1120px; margin: 0 auto; padding: 0 56px; }
  .home-section { padding-top: 40px; padding-bottom: 40px; }

  .stack-grid { display: flex; flex-direction: column; }
  .stack-row { display: grid; grid-template-columns: 160px 1fr; gap: 1rem; align-items: baseline; padding: 0.65rem 0; border-bottom: 1px solid var(--line); }
  .stack-row:last-child { border-bottom: none; }
  .stack-label { font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 0.82rem; font-weight: 600; color: var(--accent); white-space: nowrap; }
  .stack-items { font-size: 0.88rem; color: var(--mute); line-height: 1.6; }

  .contact-strip { display: flex; gap: 32px; align-items: center; border-top: 1px solid var(--line); }
  .contact-link { font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 13px; color: var(--mute); text-decoration: none; transition: color 0.15s; }
  .contact-link:hover { color: var(--ink); text-decoration: none; }

  .card-project { transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease; }
  .card-project:hover { transform: translateY(-4px); border-color: #5c9cff; box-shadow: 0 8px 24px rgba(92,156,255,0.18); text-decoration: none; }
  [data-theme="light"] .card-project:hover { border-color: #2563eb; box-shadow: 0 8px 24px rgba(37,99,235,0.15); }

  .reveal-up { opacity: 0; transform: translateY(16px); transition: opacity 420ms ease, transform 420ms ease; }
  .reveal-up.is-visible { opacity: 1; transform: translateY(0); }

  @media (max-width: 900px) {
    .home-container { padding: 0 20px; }
    .stack-row { grid-template-columns: 1fr; gap: 0.2rem; }
    .contact-strip { flex-direction: column; align-items: flex-start; gap: 12px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal-up { opacity: 1; transform: none; transition: none; }
  }
</style>
