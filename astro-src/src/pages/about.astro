---
import BaseLayout from '../layouts/BaseLayout.astro';
import { about } from '../data/about';
---

<BaseLayout title="About" description="Onkesh Bansal is a senior engineer building production AI systems, based in Toronto.">
  <section class="section">
    <div class="panel about-intro">
      <h1>{about.headline}</h1>
      {about.paragraphs.map((p) => <p>{p}</p>)}
      <div class="about-cta">
        <a href="/post/">Selected Work</a>
        <a href="/contact/">Get in touch</a>
      </div>
    </div>
  </section>


</BaseLayout>

<style is:inline>
  .about-intro h1 {
    margin: 0 0 0.85rem;
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .about-intro p {
    color: var(--text-muted);
    line-height: 1.7;
    margin: 0 0 0.75rem;
  }

  .about-intro p:last-of-type { margin-bottom: 0; }

  .about-cta {
    display: flex;
    gap: 1.2rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .about-cta a {
    font-size: 0.9rem;
    color: var(--accent);
  }
</style>
