---
import BaseLayout from '../layouts/BaseLayout.astro';
import { contact } from '../data/contact';
---

<BaseLayout title="Contact" description={contact.metaDescription}>
  <section class="hero">
    <h1>{contact.hero.headline}</h1>
    <p>{contact.hero.subline}</p>
  </section>

  <section class="section">
    <div class="contact-grid">

      <div class="panel contact-main">
        <h2>{contact.intro.heading}</h2>
        <p>{contact.intro.body}</p>
        <div class="contact-links">
          {contact.links.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer" class="contact-link-btn">
              {link.label}
            </a>
          ))}
        </div>
      </div>

      <div class="panel contact-detail">
        <h2>{contact.openTo.heading}</h2>
        <ul class="open-to-list">
          {contact.openTo.items.map((item) => (
            <li>
              <span class="ot-label">{item.label}</span>
              {item.description}
            </li>
          ))}
        </ul>
      </div>

    </div>
  </section>

  <section class="section">
    <div class="panel">
      <h2>{contact.messagingTips.heading}</h2>
      <p class="hint-intro">{contact.messagingTips.intro}</p>
      {contact.messagingTips.tips.length > 0 && (
        <ul class="hint-list">
          {contact.messagingTips.tips.map((tip) => (
            <li>{tip}</li>
          ))}
        </ul>
      )}
    </div>
  </section>
</BaseLayout>

<style is:inline>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    align-items: start;
  }

  .contact-main h2,
  .contact-detail h2 {
    margin: 0 0 0.7rem;
    font-size: 1.1rem;
  }

  .contact-main p {
    color: var(--text-muted);
    font-size: 0.93rem;
    line-height: 1.6;
    margin: 0 0 1.1rem;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .contact-link-btn {
    border: 1px solid #2a4060;
    background: #0e1e30;
    color: #9ec4e8;
    padding: 0.38rem 0.75rem;
    border-radius: 8px;
    font-size: 0.85rem;
    text-decoration: none;
    transition: border-color 130ms ease, color 130ms ease;
  }
  .contact-link-btn:hover { border-color: #4b7aab; color: #cce2ff; }

  .open-to-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.85rem;
  }

  .open-to-list li {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .ot-label {
    display: block;
    font-weight: 600;
    color: var(--text);
    font-size: 0.88rem;
    margin-bottom: 0.15rem;
  }

  .hint-intro {
    color: var(--text-muted);
    font-size: 0.93rem;
    margin: 0 0 0.7rem;
  }

  .hint-list {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.4rem;
  }

  .hint-list li {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  @media (max-width: 780px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
</style>
