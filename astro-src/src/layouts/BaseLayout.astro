---
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
  fullWidth?: boolean;
}

const { title, description = 'Onkesh Bansal — Senior engineer building production AI systems. Autonomous workflows, persistent memory, and LLM tooling. Toronto, open to remote US/Canada.', fullWidth = false } = Astro.props;
const path = Astro.url.pathname;
const canonicalURL = new URL(path, 'https://onk3sh.github.io').href;
const ogImageURL = new URL('/og-image.png', 'https://onk3sh.github.io').href;
const pageTitle = path === '/' ? `Onkesh Bansal | Senior Engineer — AI Systems & Backend Platform` : `${title} | Onkesh Bansal`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Onkesh Bansal" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Serif:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Onkesh Bansal" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Onkesh Bansal — AI systems engineer building production agent infrastructure." />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <slot name="head" />
    <script is:inline>
      (function () {
        if (localStorage.getItem('theme') === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>
  <body>
    <div class="page-shell">
      <slot name="header" />

      <main class={fullWidth ? 'main-content main-content--full' : 'main-content'}>
        <slot />
      </main>

      <footer class="site-footer">
        <div class="footer-inner">
          <span>© Onkesh Bansal · 2026 · Toronto · Remote</span>
          <span class="footer-links">
            <a href="/about/">about</a>
            <a href="/post/">work</a>
            <a href="/writing/">writing</a>
            <a href="/lab/">lab</a>
            <a href="/stack/">stack</a>
            <a href="/contact/">contact</a>
            <a href="https://www.linkedin.com/in/onkesh" target="_blank" rel="noopener">linkedin</a>
            <a href="https://github.com/onk3sh" target="_blank" rel="noopener">github</a>
          </span>
          <a href="mailto:onkesh2022@gmail.com" class="footer-email">hello</a>
        </div>
      </footer>
    </div>

    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        function sync() {
          var dark = document.documentElement.getAttribute('data-theme') === 'dark';
          btn.textContent = dark ? '☀' : '🌙';
          btn.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
        }
        sync();
        btn.addEventListener('click', function () {
          var dark = document.documentElement.getAttribute('data-theme') === 'dark';
          if (dark) {
            document.documentElement.removeAttribute('data-theme');
            localStorage.removeItem('theme');
          } else {
            document.documentElement.setAttribute('data-theme', 'dark');
            localStorage.setItem('theme', 'dark');
          }
          sync();
        });
      })();
    </script>
  </body>
</html>
